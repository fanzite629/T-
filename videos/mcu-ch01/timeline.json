  "captions": [
    {
      "start": 0.608833,
      "end": 7.991166,
      "text": "手靠近，洗手液机就出液：传感器输入信息，芯片执行程序，再"
    },
    {
      "start": 7.991166,
      "end": 15.678790999999999,
      "text": "输出控制信号。本章沿着这条链路，认识单片机、数制和存储器"
    },
    {
      "start": 16.235291,
      "end": 22.352958,
      "text": "课件介绍了课程名称、应用与考核：六十六学时分为理论"
    },
    {
      "start": 22.352958,
      "end": 29.720583,
      "text": "四十六、实验二十；成绩由期末六十和平时四十组成，具体安排"
    },
    {
      "start": 29.720583,
      "end": 35.699999000000005,
      "text": "以老师通知为准。今天重点是把原理和动作联系起来。"
    },
    {
      "start": 45.608833,
      "end": 50.92,
      "text": "看八零三一芯片，引脚负责与外部电路交换信号"
    },
    {
      "start": 51.485291000000004,
      "end": 57.852958,
      "text": "后面的工程岗位与四页招聘截图是历史示例，我们提炼三项"
    },
    {
      "start": 57.852958,
      "end": 62.002333,
      "text": "能力：读电路、写程序、会调试"
    },
    {
      "start": 62.529416,
      "end": 68.95587499999999,
      "text": "灯不亮，既可能程序没执行，也可能供电、接线或输出条件"
    },
    {
      "start": 68.95587499999999,
      "end": 74.744124,
      "text": "有问题。学习单片机，要同时追踪程序和电路。"
    },
    {
      "start": 83.608833,
      "end": 90.199416,
      "text": "课件八节内容归成四站：发展背景、系统结构、数制编码"
    },
    {
      "start": 90.3,
      "end": 96.619999,
      "text": "存储器。最后一站来自复习页后面的四页，同样要学"
    },
    {
      "start": 97.16175,
      "end": 101.949999,
      "text": "遇到练习，可暂停自己算，再核对画面答案。"
    },
    {
      "start": 109.608833,
      "end": 115.873541,
      "text": "从一九四六年的电子计算机，到电子管、晶体管和集成电路的"
    },
    {
      "start": 115.873541,
      "end": 119.590583,
      "text": "演进，关键趋势是集成度提高"
    },
    {
      "start": 120.147041,
      "end": 125.87,
      "text": "先抓住五个功能部件：输入送入信息，输出呈现结果"
    },
    {
      "start": 126.073541,
      "end": 132.678791,
      "text": "存储器保存程序和数据，运算器计算，控制器按指令协调"
    },
    {
      "start": 133.235291,
      "end": 139.119999,
      "text": "三加五时，控制器安排运算器相加，再保存或输出八"
    },
    {
      "start": 139.66175,
      "end": 144.09058299999998,
      "text": "把步骤编码并存起来，就是存储程序思想"
    },
    {
      "start": 144.647041,
      "end": 149.97941600000001,
      "text": "五部件是功能模型，具体芯片的物理结构可以不同。"
    },
    {
      "start": 160.608833,
      "end": 167.108833,
      "text": "运算器、控制器等处理核心集成成微处理器，也就是 C P"
    },
    {
      "start": 167.108833,
      "end": 174.046458,
      "text": "U。加上存储器与输入输出接口，构成微型计算机基本硬件"
    },
    {
      "start": 174.382333,
      "end": 179.237666,
      "text": "再配外围设备、电源和软件，成为可用系统"
    },
    {
      "start": 179.794125,
      "end": 186.12,
      "text": "看课件实物图，把内存、键盘、显示器对应到各自功能"
    },
    {
      "start": 186.676458,
      "end": 191.414125,
      "text": "四零零四在一九七一年十一月正式商业发布"
    },
    {
      "start": 191.970583,
      "end": 198.634707,
      "text": "我们借这段历史理解集成化：一颗处理器需要周围条件配合"
    },
    {
      "start": 198.794125,
      "end": 201.141166,
      "text": "才成为能工作的计算机。"
    },
    {
      "start": 210.608833,
      "end": 215.596458,
      "text": "三总线分别回答：找谁、传什么、怎样传"
    },
    {
      "start": 216.147041,
      "end": 222.897041,
      "text": "地址总线指定位置，数据总线搬运内容，控制总线给出读写等"
    },
    {
      "start": 222.897041,
      "end": 230.325916,
      "text": "信号。 例如读取十六进制地址三零：先给地址，再发读信号"
    },
    {
      "start": 230.544125,
      "end": 234.105291,
      "text": "该单元的五 A沿数据线返回处理器"
    },
    {
      "start": 234.66175,
      "end": 240.355291,
      "text": "三零是位置，五 A是内容，就像房间号与房内物品"
    },
    {
      "start": 240.91175,
      "end": 248.023541,
      "text": "即使某组引脚先传地址、后传数据，这三种逻辑作用仍要分清。"
    },
    {
      "start": 255.608833,
      "end": 262.405291,
      "text": "单片机把处理器、存储器和输入输出等资源集成到一颗芯片中"
    },
    {
      "start": 262.579416,
      "end": 266.0465,
      "text": "常称微控制器，简称 M C U"
    },
    {
      "start": 266.58825,
      "end": 270.193541,
      "text": "它仍需电源、时钟及应用电路"
    },
    {
      "start": 270.75,
      "end": 276.811207,
      "text": "电脑常处理多种任务，单片机常嵌在设备中执行控制"
    },
    {
      "start": 277.367666,
      "end": 283.649416,
      "text": "通用型芯片提供可组合资源，专用型针对特定用途优化"
    },
    {
      "start": 284.205875,
      "end": 290.970583,
      "text": "同一通用芯片可以做温度显示，也可以做门禁，所以专用系统"
    },
    {
      "start": 290.970583,
      "end": 298.185291,
      "text": "未必使用专用芯片。实际功能由资源、电路和程序共同决定。"
    },
    {
      "start": 307.608833,
      "end": 314.844125,
      "text": "课件用四阶段描述单片机从早期器件、四十八系列，到五一和"
    },
    {
      "start": 314.844125,
      "end": 316.905291,
      "text": "更多位宽产品的发展"
    },
    {
      "start": 317.0,
      "end": 324.279416,
      "text": "阶段会交叉。英特尔、爱特梅尔、飞利浦等厂家与型号在图中"
    },
    {
      "start": 324.279416,
      "end": 331.531791,
      "text": "对应展示。 五一兼容系列共享相近指令体系，但容量、外设"
    },
    {
      "start": 331.676458,
      "end": 334.178832,
      "text": "引脚和时序可能不同"
    },
    {
      "start": 334.735291,
      "end": 339.017041,
      "text": "八零 C 五一中的 C通常与工艺型号有关"
    },
    {
      "start": 339.573541,
      "end": 345.91175,
      "text": "学会一种结构后，可以迁移分析方法，替换芯片前仍须核对"
    },
    {
      "start": 345.91175,
      "end": 347.082333,
      "text": "具体参数。"
    },
    {
      "start": 356.608833,
      "end": 363.949416,
      "text": "课件列出基本、增强、低功耗、专用、超八位和片内闪存六类"
    },
    {
      "start": 364.514708,
      "end": 366.649416,
      "text": "基本型如八零五一"
    },
    {
      "start": 366.970583,
      "end": 373.073541,
      "text": "典型五二增强器件有二百五十六字节运行存储、三个十六位"
    },
    {
      "start": 373.073541,
      "end": 376.840582,
      "text": "定时器，片内程序容量要看型号"
    },
    {
      "start": 377.397041,
      "end": 383.75,
      "text": "低功耗关心能耗，专用型优化特定接口，超八位是课件的"
    },
    {
      "start": 383.75,
      "end": 387.737624,
      "text": "历史分类称呼，闪存便于更新程序"
    },
    {
      "start": 388.294125,
      "end": 390.369999,
      "text": "这些标签可以重叠"
    },
    {
      "start": 390.926458,
      "end": 397.544125,
      "text": "选型要问：程序和数据放得下吗，接口与定时器够吗，工作"
    },
    {
      "start": 397.544125,
      "end": 398.994125,
      "text": "条件合适吗？"
    },
    {
      "start": 407.608833,
      "end": 412.022958,
      "text": "课件展示了仪器、工业控制和日常设备"
    },
    {
      "start": 412.58825,
      "end": 419.397041,
      "text": "看鼠标、光驱、U盘：它们分别处理操作、机械控制或数据"
    },
    {
      "start": 419.397041,
      "end": 424.517041,
      "text": "传输，但都可以沿输入、处理、输出来分析"
    },
    {
      "start": 425.073541,
      "end": 428.678832,
      "text": "图中的器件与实现以原课件为例"
    },
    {
      "start": 429.220583,
      "end": 431.208208,
      "text": "选型还要看环境"
    },
    {
      "start": 431.75,
      "end": 438.737666,
      "text": "商业、工业等温度等级是工作条件，具体上下限须查对应型号"
    },
    {
      "start": 438.897041,
      "end": 443.523541,
      "text": "不能把课件示例当成所有单片机的统一规格。"
    },
    {
      "start": 451.608833,
      "end": 458.714124,
      "text": "读内部框图时先分工：处理器执行程序，程序存储器保存指令"
    },
    {
      "start": 458.882333,
      "end": 462.531791,
      "text": "运行存储器 R A M暂存数据"
    },
    {
      "start": 462.823541,
      "end": 469.50237400000003,
      "text": "时钟提供节拍，定时器计时或计数，并口、串口交换信号"
    },
    {
      "start": 469.66175,
      "end": 471.7965,
      "text": "中断帮助响应事件"
    },
    {
      "start": 472.352958,
      "end": 478.517082,
      "text": "按键经接口送入，处理器判断后更新数据，再输出控制"
    },
    {
      "start": 479.073541,
      "end": 485.926458,
      "text": "风扇等负载通常还需外部驱动，不能看到输出引脚就认为它能"
    },
    {
      "start": 485.926458,
      "end": 493.391166,
      "text": "直接带动所有设备。学习新芯片，也按这张功能清单寻找资源。"
    },
    {
      "start": 502.608833,
      "end": 506.67,
      "text": "测控系统把现实量变成可处理的信息"
    },
    {
      "start": 507.235291,
      "end": 511.693541,
      "text": "以温控为例，温度经传感器变成电信号"
    },
    {
      "start": 512.029416,
      "end": 518.544125,
      "text": "模拟电压需要模数转换后进入数字处理，按键则提供离散开关"
    },
    {
      "start": 518.544125,
      "end": 525.529416,
      "text": "状态。 处理器比较测量值与目标，经过输出接口和驱动控制"
    },
    {
      "start": 525.529416,
      "end": 531.414124,
      "text": "风扇，风扇改变温度，传感器再测量，形成闭环"
    },
    {
      "start": 531.970583,
      "end": 535.355291,
      "text": "需要模拟输出时可用数模转换"
    },
    {
      "start": 535.91175,
      "end": 542.426458,
      "text": "并非所有传感器都要外接转换器，经典八零五一也没有默认"
    },
    {
      "start": 542.426458,
      "end": 544.288208,
      "text": "内置模数转换器。"
    },
    {
      "start": 554.608833,
      "end": 561.78175,
      "text": "数制的关键是位权。十进制一九八五，是一乘一千、九乘一百"
    },
    {
      "start": 561.91175,
      "end": 568.926458,
      "text": "八乘十再加五。基数换成二，每位只用零或一，整数位权依次"
    },
    {
      "start": 568.926458,
      "end": 576.485291,
      "text": "是一、二、四、八。 因此二进制一零零一等于八加一，也就是"
    },
    {
      "start": 576.485291,
      "end": 583.897041,
      "text": "九。小数点右边依次是二分之一、四分之一、八分之一，所以"
    },
    {
      "start": 583.897041,
      "end": 586.943499,
      "text": "零点一零一等于零点六二五"
    },
    {
      "start": 587.5,
      "end": 592.45,
      "text": "相邻位权相差基数倍，位置决定贡献大小。"
    },
    {
      "start": 600.608833,
      "end": 607.272958,
      "text": "十六进制逢十六进一，零到九之后用 A到 F表示十到十五"
    },
    {
      "start": 607.83825,
      "end": 614.794125,
      "text": "三二七 H按位权展开，是三乘二百五十六，加二乘十六，再"
    },
    {
      "start": 614.794125,
      "end": 617.193499,
      "text": "加七，得到八百零七"
    },
    {
      "start": 617.75,
      "end": 624.514708,
      "text": "小数同样按权展开，右边第一位权是十六分之一，第二位是"
    },
    {
      "start": 624.514708,
      "end": 630.884708,
      "text": "二百五十六分之一。课件三 A B点一一的完整展开见画面"
    },
    {
      "start": 631.205875,
      "end": 636.002375,
      "text": "精确结果是九百三十九点零六六四零六二五"
    },
    {
      "start": 636.102958,
      "end": 639.361791,
      "text": "保留四位小数时应写约等号。"
    },
    {
      "start": 659.608833,
      "end": 664.258249,
      "text": "现在完整算一次：二进制一一一点一零一"
    },
    {
      "start": 664.823541,
      "end": 669.031791,
      "text": "整数部分选中四、二、一，合计七"
    },
    {
      "start": 669.352958,
      "end": 675.5,
      "text": "小数部分选中二分之一和八分之一，合计零点六二五，所以"
    },
    {
      "start": 675.5,
      "end": 681.926458,
      "text": "结果是七点六二五。 方法就是写出每一位的权，再把数字"
    },
    {
      "start": 681.926458,
      "end": 688.279416,
      "text": "乘权值相加。小数第二位原来是零，如果改成一，就增加"
    },
    {
      "start": 688.279416,
      "end": 694.670583,
      "text": "四分之一。看清增加的位权，比重新背一遍答案更有用。"
    },
    {
      "start": 704.608833,
      "end": 708.537624,
      "text": "十进制整数转二进制，用除二取余"
    },
    {
      "start": 709.08825,
      "end": 713.046458,
      "text": "二百一十五除二，商一百零七、余一"
    },
    {
      "start": 713.367666,
      "end": 716.355291,
      "text": "继续用商除二，直到商为零"
    },
    {
      "start": 716.897041,
      "end": 723.340583,
      "text": "画面依次得到余数一、一、一、零、一、零、一、一"
    },
    {
      "start": 723.882333,
      "end": 730.384707,
      "text": "为什么倒着读？第一次余数是个位，后面才逐渐得到高位"
    },
    {
      "start": 730.941166,
      "end": 734.472916,
      "text": "因此结果是一一零一零一一一"
    },
    {
      "start": 735.029416,
      "end": 741.62,
      "text": "用位权复核：一百二十八加六十四，加十六、四、二、一"
    },
    {
      "start": 741.823541,
      "end": 743.670583,
      "text": "正好二百一十五。"
    },
    {
      "start": 758.608833,
      "end": 766.352958,
      "text": "小数改用乘二取整。零点六八七五乘二得一点三七五，取一，剩"
    },
    {
      "start": 766.352958,
      "end": 771.017083,
      "text": "零点三七五；再乘二得零点七五，取零"
    },
    {
      "start": 771.132333,
      "end": 773.693541,
      "text": "接着得到一点五，取一"
    },
    {
      "start": 773.970583,
      "end": 777.046457,
      "text": "最后得到一，取一，结束"
    },
    {
      "start": 777.58825,
      "end": 782.002375,
      "text": "整数位按出现顺序读，得到零点一零一一"
    },
    {
      "start": 782.558833,
      "end": 789.33825,
      "text": "乘二把当前最高的小数位移到整数部分，所以顺序与整数除二"
    },
    {
      "start": 789.33825,
      "end": 796.441166,
      "text": "法不同。如果一直不能归零，就按要求截取或舍入，有限位结果"
    },
    {
      "start": 796.441166,
      "end": 798.2882079999999,
      "text": "可能只是近似值。"
    },
    {
      "start": 816.608833,
      "end": 822.905291,
      "text": "因为十六等于二的四次方，一个十六进制数码对应四个二进制位"
    },
    {
      "start": 823.470583,
      "end": 828.443541,
      "text": "九 A B点七 C五逐位替换，完整结果见画面"
    },
    {
      "start": 829.0,
      "end": 835.08825,
      "text": "反过来，从小数点向两侧各四位分组，就得到课件的一 B"
    },
    {
      "start": 835.08825,
      "end": 840.619999,
      "text": "E三点九七八。 整数端不足四位，在最左补零"
    },
    {
      "start": 840.867666,
      "end": 843.987666,
      "text": "小数端不足四位，在最右补零"
    },
    {
      "start": 844.544125,
      "end": 850.825874,
      "text": "比如一零一点一补成零一零一点一零零零，得到五点八 H"
    },
    {
      "start": 851.367666,
      "end": 854.729416,
      "text": "补零位置错了，数值就会改变。"
    },
    {
      "start": 875.608833,
      "end": 878.846458,
      "text": "二进制四则运算仍按位对齐"
    },
    {
      "start": 879.41175,
      "end": 884.649374,
      "text": "加法逢二进一：一零零加一一一，得到一零一一"
    },
    {
      "start": 885.205875,
      "end": 891.955875,
      "text": "减法向高位借一，当作本位的二：一零一一减零一一零，得到"
    },
    {
      "start": 891.955875,
      "end": 898.619999,
      "text": "零一零一。 乘法遇零写零，遇一复制被乘数，并按位左移"
    },
    {
      "start": 899.16175,
      "end": 905.41175,
      "text": "一一一乘一零一，就是七加二十八，得到三十五，二进制为"
    },
    {
      "start": 905.41175,
      "end": 912.941166,
      "text": "一零零零一一。除法依次比较、减去、写商：课件两题的商分别"
    },
    {
      "start": 912.941166,
      "end": 916.185291,
      "text": "是一零和一一，余数都为零。"
    },
    {
      "start": 934.608833,
      "end": 937.302333,
      "text": "练习先用方法，再看答案"
    },
    {
      "start": 937.867666,
      "end": 942.634666,
      "text": "一零一一零一点一零的位权相加是四十五点五"
    },
    {
      "start": 943.0,
      "end": 948.237624,
      "text": "逆向转换会回到同一个值，小数末尾的零可以省略"
    },
    {
      "start": 948.794125,
      "end": 953.502374,
      "text": "连续低位全是一的数，等于二的相应次幂减一"
    },
    {
      "start": 954.058833,
      "end": 958.75,
      "text": "例如 F F是二百五十五，F F F F是"
    },
    {
      "start": 958.75,
      "end": 960.899416,
      "text": "六万五千五百三十五"
    },
    {
      "start": 961.455875,
      "end": 967.7229159999999,
      "text": "十六进制一零零零则是二的十二次幂，等于四千零九十六"
    },
    {
      "start": 968.279416,
      "end": 973.655916,
      "text": "其余题的完整答案分两屏展示，可暂停逐项核对。"
    },
    {
      "start": 994.608833,
      "end": 999.405291,
      "text": "同一串比特怎样解释，要先约定字长和编码"
    },
    {
      "start": 999.970583,
      "end": 1005.134707,
      "text": "这里固定八位。无符号数所有位都表示大小"
    },
    {
      "start": 1005.441166,
      "end": 1010.472957,
      "text": "原码用最高位表示正负，其余七位表示绝对值"
    },
    {
      "start": 1011.029416,
      "end": 1014.502332,
      "text": "正数的原码、反码、补码相同"
    },
    {
      "start": 1015.058833,
      "end": 1020.840582,
      "text": "负数从原码出发，符号位不变，其余取反，得到反码"
    },
    {
      "start": 1021.147041,
      "end": 1023.605291,
      "text": "反码再加一，得到补码"
    },
    {
      "start": 1024.16175,
      "end": 1030.708208,
      "text": "例如负三原码一零零零零零一一，反码一一一一一一零零"
    },
    {
      "start": 1030.91175,
      "end": 1033.414124,
      "text": "补码一一一一一一零一"
    },
    {
      "start": 1033.970583,
      "end": 1036.008832,
      "text": "全过程保持八位。"
    },
    {
      "start": 1044.608833,
      "end": 1050.88825,
      "text": "按这个规则，负四从八四 H变成 F B，再加一得到 F"
    },
    {
      "start": 1050.88825,
      "end": 1056.634707,
      "text": "C；负七从八七变成 F八，再加一得到 F九"
    },
    {
      "start": 1057.176458,
      "end": 1060.972958,
      "text": "每步的八位变化在画面里逐格对应"
    },
    {
      "start": 1061.529416,
      "end": 1064.355291,
      "text": "补码使减法可以转成加法"
    },
    {
      "start": 1064.91175,
      "end": 1070.91175,
      "text": "五加负四，零五加 F C得到一零一 H，保留低八位是"
    },
    {
      "start": 1070.91175,
      "end": 1078.252333,
      "text": "零一，结果正确。负数八位补码也可用二百五十六减绝对值检查"
    },
    {
      "start": 1078.808833,
      "end": 1084.861791,
      "text": "丢弃位宽外进位，不等于保证所有运算都没有有符号溢出。"
    },
    {
      "start": 1103.608833,
      "end": 1107.522958,
      "text": "八位无符号数范围是零到二百五十五"
    },
    {
      "start": 1108.08825,
      "end": 1114.220583,
      "text": "原码、反码都有正零和负零，范围为负一百二十七到正"
    },
    {
      "start": 1114.220583,
      "end": 1120.544125,
      "text": "一百二十七；补码只有一个零，范围扩展为负一百二十八到正"
    },
    {
      "start": 1120.544125,
      "end": 1126.720583,
      "text": "一百二十七。 原因可以看位权：八位补码最高位权是负"
    },
    {
      "start": 1126.720583,
      "end": 1129.737624,
      "text": "一百二十八，其余仍是正权"
    },
    {
      "start": 1130.294125,
      "end": 1134.943541,
      "text": "一零零零零零零零因此表示负一百二十八"
    },
    {
      "start": 1135.5,
      "end": 1141.852958,
      "text": "正一百二十七再加一超出范围，位串虽变成这个负数，却不"
    },
    {
      "start": 1141.852958,
      "end": 1146.008833,
      "text": "代表数学答案变负了，这叫有符号溢出。"
    },
    {
      "start": 1159.608833,
      "end": 1166.402958,
      "text": "练习以正负十三示范：十三写成八位零零零零一一零一，正数"
    },
    {
      "start": 1166.402958,
      "end": 1172.279416,
      "text": "编码不变；负十三原码是八 D，补码是 F三，也就是"
    },
    {
      "start": 1172.279416,
      "end": 1179.176458,
      "text": "二百五十六减十三。 剩余正负零、正负一、正负十分屏列出"
    },
    {
      "start": 1179.176458,
      "end": 1182.164124,
      "text": "完整二进制与十六进制答案"
    },
    {
      "start": 1182.720583,
      "end": 1187.472957,
      "text": "特别注意负零的原码是八零，补码归为零零"
    },
    {
      "start": 1187.764708,
      "end": 1195.029416,
      "text": "负一补码是全一。反过来，F三当无符号数是二百四十三，当"
    },
    {
      "start": 1195.029416,
      "end": 1199.067624,
      "text": "八位补码则减二百五十六，得到负十三。"
    },
    {
      "start": 1219.608833,
      "end": 1226.520583,
      "text": "存储器可按用途和介质分类，课件的磁、光及半导体器件放在"
    },
    {
      "start": 1226.520583,
      "end": 1234.117666,
      "text": "分类树中。分析容量时抓住三个概念：地址选哪个单元，单元数"
    },
    {
      "start": 1234.117666,
      "end": 1239.605291,
      "text": "表示有多少位置，单元位数表示每处能放多少比特"
    },
    {
      "start": 1240.16175,
      "end": 1246.046458,
      "text": "像旅店的房间号、房间总数和每间床位，三者不同"
    },
    {
      "start": 1246.602958,
      "end": 1249.546499,
      "text": "两根地址线能给四种组合"
    },
    {
      "start": 1249.852958,
      "end": 1254.884708,
      "text": "一般地，n根地址线可区分二的 n次方个单元"
    },
    {
      "start": 1255.441166,
      "end": 1260.6411659999999,
      "text": "总比特容量再乘每单元位数，不能只数数据线。"
    },
    {
      "start": 1271.608833,
      "end": 1278.167666,
      "text": "一字节等于八比特，本课件的一 K按一千零二十四计算，字按"
    },
    {
      "start": 1278.167666,
      "end": 1285.414083,
      "text": "十六位使用。连续编址从零开始时，最高地址比单元总数少一"
    },
    {
      "start": 1285.970583,
      "end": 1291.867666,
      "text": "例如四 K字节有四千零九十六个字节单元，末地址是"
    },
    {
      "start": 1291.867666,
      "end": 1295.399416,
      "text": "四千零九十五，即零 F F F"
    },
    {
      "start": 1295.955875,
      "end": 1299.737624,
      "text": "六十四 K字节则到 F F F F"
    },
    {
      "start": 1300.294125,
      "end": 1303.737625,
      "text": "其余容量范围在两屏表中列全"
    },
    {
      "start": 1304.294125,
      "end": 1308.678832,
      "text": "反向计算时，用末地址减首地址再加一"
    },
    {
      "start": 1309.014708,
      "end": 1311.979416,
      "text": "漏掉这个一，就少算一个单元。"
    },
    {
      "start": 1330.608833,
      "end": 1337.167666,
      "text": "看二七六四引脚：地址线从 A零到 A十二，共十三根，可选"
    },
    {
      "start": 1337.167666,
      "end": 1341.575874,
      "text": "二的十三次方，也就是八千一百九十二个单元"
    },
    {
      "start": 1342.132333,
      "end": 1345.708249,
      "text": "数据线 D零到 D七，每单元八位"
    },
    {
      "start": 1346.25,
      "end": 1351.941166,
      "text": "容量是八千一百九十二乘八比特，等于六十四 K比特，也"
    },
    {
      "start": 1351.941166,
      "end": 1357.972916,
      "text": "等于八 K字节。由零开始，末地址是一 F F F"
    },
    {
      "start": 1358.529416,
      "end": 1365.075916,
      "text": "片选、输出允许和编程控制各有作用，低有效横线要保留"
    },
    {
      "start": 1365.632333,
      "end": 1371.199999,
      "text": "算容量的顺序始终是先数单元，再看每单元宽度。"
    },
    {
      "start": 1390.608833,
      "end": 1396.228832,
      "text": "用四条线索收束：单片机集成处理、存储和接口"
    },
    {
      "start": 1396.55,
      "end": 1399.919999,
      "text": "总线区分地址、数据、控制"
    },
    {
      "start": 1400.0,
      "end": 1404.075874,
      "text": "数制按位权换算，编码须先定字长"
    },
    {
      "start": 1404.367666,
      "end": 1408.017041,
      "text": "存储容量由单元数量和宽度决定"
    },
    {
      "start": 1408.573541,
      "end": 1414.882333,
      "text": "请核对画面五道检查，能解释原因再进入下一章：整数除二"
    },
    {
      "start": 1414.882333,
      "end": 1417.825874,
      "text": "要倒序，小数乘二要顺序"
    },
    {
      "start": 1417.970583,
      "end": 1421.105291,
      "text": "八位补码下限是负一百二十八"
    },
    {
      "start": 1421.441166,
      "end": 1426.149416,
      "text": "十三根地址线、每单元八位，就是八 K字节"
    },
    {
      "start": 1426.705875,
      "end": 1430.758833,
      "text": "下一章把这些概念放进真实的五一结构。"
    }
  ]
}
